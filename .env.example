# ==============================================================================
# Google Maps API Store Locator - Environment Configuration Example
# ==============================================================================
# Server & Runtime Configuration
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Google Maps Platform Credentials
# Optional: If unset or empty, the built-in offline mock Google Maps engine
# automatically simulates Geocoding, Places Details, Distance Matrix & Directions.
GOOGLE_MAPS_API_KEY=

# Default Geospatial Search Parameters
DEFAULT_LATITUDE=37.774929
DEFAULT_LONGITUDE=-122.419416
DEFAULT_SEARCH_RADIUS_KM=25
MAX_SEARCH_RADIUS_KM=100

# Persistence & Storage
DATABASE_URL=sqlite:///storage/store_locator.db
